    // --- set atoms & bonds; append reverse bonds with symmetric/antisymmetric split explicitly ---
    function set_bond_atoms(atoms, bonds) {
        this.atoms = atoms;

        n_bonds = length(bonds);
        //add the reverse bonds
        for (b=0; b<n_bonds; b++) {
            atom1 = bonds[b].atom0;
            atom0 = bonds[b].atom1;

            r1 = bonds[b].unit_cell_of_atom_0;  // int[3]
            r0 = bonds[b].unit_cell_of_atom_1;

            j_mat = bonds[b].j
            j_mat_T = transpose(j_mat)
            j_mat_sym = (j_mat + j_mat_T) / 2
            j_mat_asym = (j_mat - j_mat_T) / 2
            j = j_mat_sym - j_mat_asym
            //create reverse bond
            rev = Bond(this, atom0, atom1, r0, r1, j)
            //add reverse bond to list of bonds
            bonds.append(rev);
        }

        this.bonds = bonds;
        this.N     = length(atoms);
        
        
