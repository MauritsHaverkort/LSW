class Atom {
    // ---------- fields ----------
    double position[3];                         // relative position in unit cell
    double S;                                   // spin length
    double dir[3];                              // unit spin direction
    complex R_prime[3,3];                       // rotation: dir -> z_dir
    complex v[3];                               // v[μ] = R_prime[μ,2]
    complex u[3];                               // u[μ] = R_prime[μ,0] + i * R_prime[μ,1]

    // ---------- constructor ----------
    function __init__(position_in[3],
                      type_in,
                      S_in = 1.0,
                      spin_dir_in = null) 
    {
        this.type  = type_in; //index of the atom 

        // position
        this.position[μ] = position_in[μ];   // relative position in the unit cell

       
        // spin length
        this.S = S_in;

        
        this.dir[μ] = normalise(spin_dir_in[μ]);
        

        // rotation that maps dir → z-axis
        double z_dir[3] = [0, 0, 1];
        this.R_prime[μ,ν] = rotation_matrix_from_vectors(z_dir, this.dir)[μ,ν]; //returns the rotation matrix rotating dir to z-axis

        // u,v are later used in the Hamiltonian construction for taking care of the local rotation of every atom
        this.v[μ] = this.R_prime[μ, 2];                         
        this.u[μ] = this.R_prime[μ, 0] + i * this.R_prime[μ, 1];
    }
}


class Bond {

    // ---------- fields ----------
    Atom   atom0;                         // first atom
    Atom   atom1;                         // second atom

    double unit_cell_of_atom_0[3];                        // unit_cell_of_atom_0
    double unit_cell_of_atom_1[3];                        // unit_cell_of_atom_1

    double s0;                            // spin of atom0
    double s1;                            // spin of atom1

    double d_absolut[3];                            // absolute vector: r1 - r0 + (unit_cell_of_atom_1 - unit_cell_of_atom_0)
    double d_of_unit_cells[3];                       // unit-cell offset: unit_cell_of_atom_1 - unit_cell_of_atom_0

    double j[3,3];                              // exchange (3×3); scalar → scalar*unit_matrix
    double r_matrix[3,3];                      // rotation matrix R_{n−m} (3×3)

    // ---------- constructor ----------
    function __init__(material,
                      atom0_in, atom1_in,
                      unit_cell_of_atom_0,
                      unit_cell_of_atom_1,
                      j_in)
    {
        this.atom0 = atom0_in;
        this.atom1 = atom1_in;

        // unit-cell coordinates
        this.unit_cell_of_atom_0 = unit_cell_of_atom_0;
        this.unit_cell_of_atom_1 = unit_cell_of_atom_1;

        // spins
        this.s0 = this.atom0.S;
        this.s1 = this.atom1.S;

        // unit-cell difference
        this.d_of_unit_cells = this.unit_cell_of_atom_1 - this.unit_cell_of_atom_0;

        // absolute vector between sites
        this.d_absolut = (this.atom1.position - this.atom0.position) + (this.unit_cell_of_atom_1 - this.unit_cell_of_atom_0);

        // exchange: if scalar → scalar * I; else copy 3×3
        if (is_scalar(j_in)) {
            this.j[μ,ν] = j*unit_matrix[μ,ν];                
        } else {
            this.j = j_in;
        }

       
        // θ: angle of rotation between the two atoms of the bond
        theta =  2 * PI * tau[v] * d_of_unit_cells[v];

        // r_matrix = rotation matrix around normal_vector_to_rotation_plane by angle theta
        this.r_matrix[μ,ν] = rotation.rot_vec(theta, material.normal_vector_to_rotation_plane);
        
    }
}

