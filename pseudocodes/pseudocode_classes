                [this.normal_vector_to_rotation_plane[2], 0, -this.normal_vector_to_rotation_plane[0]],
                [-this.normal_vector_to_rotation_plane[1], this.normal_vector_to_rotation_plane[0], 0],
            ]
        
        //R2 = n n^T
        this.mat_R2 = (this.normal_vector_to_rotation_plane[μ]* this.normal_vector_to_rotation_plane[ν])
        this.mat_R1 = (unit_matrix[μ,ν] - i * mat_nx[μ,ν] - this.mat_R2[μ,ν]) / 2

    }

    
    

    // --- incommensurability ---
    function is_incommensurate() {
        //check if tau is not [0,0,0]
        return this.tau != [0,0,0];
