main(cfg, mat): 
  q_grid = make_k_grid(mat.lattice_vectors, cfg)      # 3D BZ grid

    Epart, T, eigvals, w, eigvals_d, T_d = create_bog_pref_grid(cfg, mat, q_grid)

    calculate_convolutions_of_bog_trafo_pref_grid(
      cfg, q_values_grid=q_grid, w_values=w,
      material=mat, energy_dependent_part=Epart, T=T,
      eigvalue_grid=eigvals, eigvalues_deriv=eigvals_d, T_deriv=T_d
    )

# ---- physics builders ----
create_bog_pref_grid(cfg, mat, q_grid):
  τ_shifts = build_tau_shifts(cfg, mat)
  for τ in τ_shifts:
    (H_diag, _, _, T), (H_deriv, ...) = current_Hamiltonian_to_use(cfg, q_grid+τ, mat)
    if first τ: w = choose_energy_axis(H_diag, cfg)
    Epart_τ = calc_spectral_weight_grid(H_diag, w, Γ=cfg.Gamma)   # diagonal elements only
    stash(T, H_diag, Epart_τ, and optionally derivatives)
  return (Epart[τ], T[τ], eigvals=diag(H_diag), w, eigvals_deriv=diag(H_deriv), T_deriv)

current_Hamiltonian_to_use(cfg, q_grid, mat):
  if cfg.use_hamiltonian_paper_4:
    (H_diag_tuple, H_deriv_tuple) = general_Ham_types_AFM_FM_paper_4(cfg, q_grid, mat)
    return (H_diag_tuple, H_deriv_tuple)

general_Ham_types_AFM_FM_paper_4(cfg, k_grid, mat):
  # build A, mA, B, mB, C from bonds, spins, local frames, e^{±ik·d}
  H(k) = [[A−C,  B],
          [ mB, mA−C]]
  H_diag_tuple = diagonalising_Hamiltonian(cfg, H, k_shape, N=mat.N)
  if cfg.compute_T_derivatives: H_deriv = assemble_block_derivatives(...)
  return (H_diag_tuple, H_deriv or None)

diagonalising_Hamiltonian(cfg, H(k), shape, N):
  Γ = bosonic_metric(N)
  for each k:
    (λ, V) = eig(Γ Hk); sort; (optionally) orthonormalize & normalize so V† Γ V = Γ
    store λ, V, and Γ·diag(λ)
  return (H_diag_grid, state_cr, state_cr, eigvecs_grid=T)

# ---- measurement side ----
calculate_convolutions_of_bog_trafo_pref_grid(cfg, q_grid, w, material, Epart, T, eigs, ...):
  (FF, k_pref, ...) = create_form_factor_matrix(material, cfg, q_grid)

  if cfg.use_calc_of_S_a_ad:
    # build sqw′ in (a,a†):
    Th = T† ; S′_a,a† (k,ω) = (Th · [k_pref or I] · T) ⊗ Epart, then trace over creation subspace
    reshape to per-(i,order_i,j,order_j) blocks
    if cfg.calc_conv_intensities:
      S′_4 = FFT-convolutions of 2-point blocks
      reapply k_pref (or extended-grid phase)
    # map (a,a†) → (x,y,z):
    S′_2_xyz = map_2pt(S′_2) ; S′_4_xyz = map_4pt(S′_4)
  else:
    # direct 2-pt route:
    S′_2_xyz(k,ω) = (T† · FF · T) ⊗ Epart, then trace

  # combine sqw′ components → sqw, then symmetrize if supercell:
  sqw_2_xyz = sqw_prime_to_sqw(cfg, S′_2_xyz, material)
  sqw_2_xyz_sym = symmetrise_sqw(sqw_2_xyz, material)
  return sqw_2_xyz_sym
